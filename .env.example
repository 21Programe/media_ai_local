# Device: "cuda" (NVIDIA) ou "cpu"
DEVICE=cuda

# Low VRAM (true/false)
LOW_VRAM=true

# Modelos
# SDXL (pesado): stabilityai/stable-diffusion-xl-base-1.0
# SD 1.5 (leve): runwayml/stable-diffusion-v1-5
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Video model (image->video)
VIDEO_MODEL=stabilityai/stable-video-diffusion-img2vid-xt

# Caminhos
DATA_DIR=./data
SQLITE_PATH=./data/app.db
FAISS_DIR=./data/faiss

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Limites (segurança/performance)
MAX_IMAGE_SIZE=1024
MAX_VIDEO_FRAMES=25
MAX_VIDEO_FPS=8